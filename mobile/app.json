{
  "expo": {
    "name": "RESQ",
    "slug": "resq-mobile",
    "version": "1.0.0",
    "scheme": "resq",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05070d",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#05070d",
      "resizeMode": "contain"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#05070d"
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#05070d"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "RESQ needs your location to send accurate help to your exact position during an emergency.",
          "locationWhenInUsePermission": "RESQ needs your location to send accurate help to your exact position during an emergency.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#cc0000",
          "sounds": [
            "./assets/siren.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RESQ needs access to your photos to attach evidence to an emergency.",
          "cameraPermission": "RESQ needs camera access to let you photograph the situation during an emergency."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "RESQ needs microphone access to let you send a voice note during an emergency."
        }
      ],
      "expo-asset",
      [
        "@sentry/react-native/expo",
        {
          "organization": "resqapp254",
          "project": "resq-mobile",
          "disableAutoUpload": true
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RESQ needs your location to send accurate help to your exact position during an emergency.",
        "NSMicrophoneUsageDescription": "RESQ needs microphone access to let you send a voice note during an emergency."
      }
    },
    "android": {
      "package": "com.resqapp254.resqmobile",
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05070d"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_NOTIFICATION_POLICY",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "90e12016-b617-4fc0-8f59-2d6f5d47cf35"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/90e12016-b617-4fc0-8f59-2d6f5d47cf35"
    }
  }
}
