# Copy this file to .env (never commit .env)

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Local development: your computer's LAN IP + port 3000, e.g. http://192.168.1.42:3000
# Production: the deployed Vercel dashboard URL, with no trailing slash.
EXPO_PUBLIC_API_BASE_URL=

# Firebase (for FCM push / critical alerts)
# google-services.json (Android) and GoogleService-Info.plist (iOS)
# go directly in mobile/ root — never paste their contents in chat
