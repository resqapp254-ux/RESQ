# Copy this file to .env.local and fill in real values (never commit .env.local)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Groq (free) — AI advice engine, called from server routes only
GROQ_API_KEY=
# Optional; defaults to openai/gpt-oss-120b. Check Groq's model catalog before changing it.
GROQ_MODEL=openai/gpt-oss-120b

# Africa's Talking (Day 8 — offline USSD/SMS + admin SMS alerts)
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
# Day 14 hardening: Africa's Talking doesn't sign webhook requests, so
# generate a random secret and put it both here and as ?key=... on the
# USSD/SMS callback URLs registered in the Africa's Talking dashboard.
# Leaving this unset works but leaves those webhooks unauthenticated.
AFRICASTALKING_WEBHOOK_SECRET=
# Day 18 escalation — optional. Only set this once you've provisioned
# a Voice-enabled number in the Africa's Talking dashboard and pointed
# its Voice Callback URL at /api/voice/callback. Left unset, escalation
# still SMS's responders after a few minutes unclaimed, it just skips
# the follow-up call.
AFRICASTALKING_VOICE_NUMBER=

# Resend (free, 100 emails/day) — institution admin resolution emails
RESEND_API_KEY=

# Day 18 escalation cron — a random secret you send back as
# `Authorization: Bearer <this>` from whatever pings /api/cron/escalate
# (e.g. cron-job.org or an UptimeRobot HTTP(s) monitor — see
# docs/deployment-readiness.md; there's deliberately no native Vercel
# Cron here, it can reject a whole deployment on the Hobby plan).
# Leaving this unset works but leaves that route only rate-limited, not
# authenticated — set it before relying on this feature in production.
CRON_SECRET=
